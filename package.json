{
  "name": "clarevix-store",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Clarevix — Pakistan's Clean Luxury Skincare. Storefront + admin panel built with Astro and Supabase.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.astro",
    "format": "prettier --write \"**/*.{js,ts,astro,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,ts,astro,md,json,css}\"",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12",
    "@supabase/supabase-js": "^2.45.0",
    "astro": "^5.1.0",
    "isomorphic-ws": "^5.0.0",
    "nanostores": "^0.11.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.92.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
