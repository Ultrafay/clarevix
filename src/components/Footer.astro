---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-grid">
    <div>
      <p class="footer-brand-name">Clarevix</p>
      <p class="footer-brand-desc">
        Pakistan's luxury clean skincare brand. Where active science meets quiet apothecary
        elegance.
      </p>
      <div class="footer-socials">
        <a
          class="footer-social"
          href="https://instagram.com/clarevix.official"
          target="_blank"
          rel="noopener noreferrer"
          title="Instagram"
          aria-label="Instagram"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <rect x="1" y="1" width="12" height="12" rx="3" stroke="currentColor" stroke-width="1"
            ></rect>
            <circle cx="7" cy="7" r="3" stroke="currentColor" stroke-width="1"></circle>
            <circle cx="10.5" cy="3.5" r="0.8" fill="currentColor"></circle>
          </svg>
        </a>
        <a
          class="footer-social"
          href="https://facebook.com/clarevix.official"
          target="_blank"
          rel="noopener noreferrer"
          title="Facebook"
          aria-label="Facebook"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path
              d="M9 2H7C5.9 2 5 2.9 5 4V6H3V9H5V13H8V9H10L10.5 6H8V4.5C8 4.2 8.2 4 8.5 4H10V2Z"
              stroke="currentColor"
              stroke-width="1"
              fill="none"></path>
          </svg>
        </a>
        <a class="footer-social" href="mailto:hello@clarevix.com" title="Email" aria-label="Email">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <rect x="1" y="3" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1"
            ></rect>
            <path d="M1 4.5L7 8L13 4.5" stroke="currentColor" stroke-width="1"></path>
          </svg>
        </a>
      </div>
    </div>
    <div>
      <p class="footer-col-title">Shop</p>
      <ul class="footer-links">
        <li><a href="/products?cat=Facewash">Facewash</a></li>
        <li><a href="/products?cat=Serum">Serums</a></li>
        <li><a href="/products?cat=Moisturizer">Moisturizers</a></li>
        <li><a href="/products?cat=Sunscreen">Sunscreens</a></li>
        <li><a href="/products?cat=Mask">Masks</a></li>
        <li><a href="/products?cat=Shampoo">Shampoo</a></li>
        <li><a href="/products?cat=Oil">Hair Oil</a></li>
        <li><a href="/products?cat=Tonic">Hair Tonic</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-col-title">Brand</p>
      <ul class="footer-links">
        <li><a href="/">Home</a></li>
        <li><a href="/certificates">Certificates</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/products">All Products</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {year} Clarevix. All rights reserved.</p>
    <p>Pakistan's Clean Luxury Skincare</p>
  </div>
</footer>
