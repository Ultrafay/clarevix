---
// Cart sidebar — content rendered client-side from the cart store
---

<aside class="cart-sidebar" id="cartSidebar" aria-label="Shopping cart">
  <div class="cart-header">
    <span class="cart-title">Your Bag</span>
    <button class="cart-close" id="cartClose" aria-label="Close cart">✕</button>
  </div>
  <div id="cartContent">
    <p class="cart-empty">
      Your bag is beautifully empty.<br />Explore our collection to begin.
    </p>
  </div>
</aside>
<div class="mob-overlay" id="cartOverlay"></div>
